# ── المفاتيح (ماتعطيهم لحد) ──
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# ── الدخول للصفحة ──
APP_USER=admin
APP_PASSWORD=بدل-هادي-بكلمة-سر-قوية

# ── الأصوات: سمية=ID مفصولين بـ ;  (اللول هو الافتراضي)
# "gemini:Kore" = صوت Gemini TTS (أرخص بزاف)، والباقي ElevenLabs
VOICES=MASTER ADS VOICE=4GrPPhyFD4Md4Rvs3kqR;Yassine=H6pm0ljbvfqt4fzJd9Py;Ghizlane=OfGMGmhShO8iL9jCkXy8;Gemini Kore (رخيص)=gemini:Kore;Gemini Puck (رخيص)=gemini:Puck

# ── الموديلات ──
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
ELEVEN_MODEL=eleven_v4

# ── المونتاج ──
# صوت الفيديو الأصلي تحت التعليق
ORIG_VOLUME=0.15
# أقصى تسريع للجملة باش تدخل فاللقطة ديالها
MAX_TEMPO=1.25

# ── التوضيح ──
AUTO_ENHANCE=1
# تحت هاد الرقم = مضبب
BLUR_THRESHOLD=100
# أصغر من 720p = كيتوضح
MIN_SHORT_SIDE=720
TARGET_SHORT_SIDE=1080

# ── التصاور ──
# شحال من لقطة (كل وحدة = 7 مقاسات)
AD_FRAMES=2
AD_COLOR=#E4572E
# 1 = Gemini كيحسن اللقطة لصورة احترافية (كيتخلص)
AD_AI_POLISH=0
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# المراحل الخفيفة (Gemini/تصاور) فنفس الوقت، والمونتاج (FFmpeg) واحد فالمرة فالسيرفر الصغير
LIGHT_WORKERS=3
HEAVY_WORKERS=1
DATA_DIR=./data

# ── صفحات الهبوط ──
# الرابط ديال الـ CRM ديال Shopping Net (الطلبات كيمشيو لـ /storeApi/)
CRM_URL=
# مفتاح سري اختياري كيتصيفط مع كل طلب (خاصو يتزاد فالـ CRM حتى هو)
CRM_SECRET=
# مفتاح Claude: كيكتب صفحات الهبوط (إلا ماكانش، كيكتبها Gemini)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
